{
  "name": "codragraph-monorepo",
  "private": true,
  "description": "CodraGraph monorepo - code intelligence platform (CLI/MCP, web UI, shared types, plugins, harness, SDK)",
  "author": {
    "name": "Thinqmesh Technologies",
    "email": "hello@thinqmesh.com",
    "url": "https://thinqmesh.com"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/shared",
    "packages/harness",
    "packages/compress",
    "packages/sdk",
    "packages/graphstore",
    "packages/org",
    "apps/web",
    "integrations/claude",
    "integrations/codex"
  ],
  "trustedDependencies": [
    "@codragraph/cli",
    "onnxruntime-node",
    "tree-sitter-dart",
    "tree-sitter-kotlin",
    "tree-sitter-proto",
    "tree-sitter-swift"
  ],
  "overrides": {
    "@langchain/anthropic": {
      "@anthropic-ai/sdk": "0.90.0"
    }
  },
  "scripts": {
    "prepare": "husky",
    "codragraph:source": "tsx packages/core/src/cli/index.ts",
    "codragraph:detect-staged": "tsx packages/core/src/cli/index.ts detect-changes --scope staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,json,css,yml,yaml}": "prettier --write"
  },
  "homepage": "https://github.com/AnitChaudhry/CodraGraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnitChaudhry/CodraGraph.git"
  },
  "bugs": {
    "url": "https://github.com/AnitChaudhry/CodraGraph/issues"
  }
}
