{
  "name": "@codragraph/sdk",
  "version": "2.2.1",
  "description": "One-import surface for the CodraGraph platform — graph intelligence, dynamic harness, compression. Works with Claude Code, Codex, OpenCode, any inference.",
  "author": {
    "name": "Anit Chaudhry",
    "email": "hello@thinqmesh.com",
    "url": "https://github.com/AnitChaudhry"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "codragraph",
    "ai-agent",
    "mcp",
    "claude-code",
    "codex",
    "opencode",
    "code-intelligence",
    "knowledge-graph",
    "meta-harness",
    "agentic-ai",
    "token-savings"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./compress": {
      "types": "./dist/compress.d.ts",
      "default": "./dist/compress.js"
    },
    "./swarm": {
      "types": "./dist/swarm.d.ts",
      "default": "./dist/swarm.js"
    },
    "./graphstore": {
      "types": "./dist/graphstore.d.ts",
      "default": "./dist/graphstore.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "default": "./dist/recipes.js"
    },
    "./graphpack": {
      "types": "./dist/graphpack.d.ts",
      "default": "./dist/graphpack.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/run-workspace-script.mjs @codragraph/harness build && node ../../scripts/run-workspace-script.mjs @codragraph/compress build",
    "build": "tsc",
    "pretest": "node ../../scripts/run-workspace-script.mjs @codragraph/harness build && node ../../scripts/run-workspace-script.mjs @codragraph/compress build",
    "test": "vitest run --passWithNoTests",
    "prepack": "node ../../scripts/run-workspace-script.mjs @codragraph/sdk build"
  },
  "dependencies": {
    "@codragraph/cli": "^2.2.0",
    "@codragraph/harness": "^2.2.0",
    "@codragraph/compress": "^2.2.0",
    "@codragraph/graphstore": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/AnitChaudhry/CodraGraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnitChaudhry/CodraGraph.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/AnitChaudhry/CodraGraph/issues"
  }
}
