{
  "name": "@codragraph/harness",
  "version": "2.2.1",
  "description": "Auto-tuned harnesses for AI agents — Meta-Harness algorithm with Pareto search over (accuracy, tokens, latency)",
  "author": {
    "name": "Anit Chaudhry",
    "email": "hello@thinqmesh.com",
    "url": "https://github.com/AnitChaudhry"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "meta-harness",
    "agentic-ai",
    "claude-code",
    "codex",
    "opencode",
    "mcp",
    "codragraph",
    "pareto-search",
    "ai-agent"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "codragraph-harness": "dist/cli/main.js"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist",
    "README.md",
    "RFC.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@codragraph/cli": "^2.2.0",
    "@codragraph/shared": "^2.2.0",
    "commander": "^14.0.3",
    "esbuild": "^0.24.0",
    "openai": "^4.70.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/AnitChaudhry/CodraGraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnitChaudhry/CodraGraph.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/AnitChaudhry/CodraGraph/issues"
  }
}
