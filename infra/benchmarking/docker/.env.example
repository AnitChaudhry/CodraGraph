# Copy to .env and fill in.
# Pick ONE model — the docker compose stack loads exactly one at a time.

# === Model selection ===
# Pick from Benchmarking/models/01-model-matrix.md
MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# Pin a HuggingFace commit SHA for reproducibility (find on HF "Files and versions" tab)
MODEL_REVISION=
# Quantization: empty | awq | gptq | fp8 | bitsandbytes
MODEL_QUANT=

# === vLLM tuning ===
GPU_MEMORY_UTILIZATION=0.9
MAX_MODEL_LEN=32768
# Number of GPUs for tensor parallelism (1 unless you have multiple)
TENSOR_PARALLEL_SIZE=1
# Concurrent in-flight requests vLLM allows
MAX_NUM_SEQS=64
# Tokens per scheduling iteration; tune for KV cache pressure
MAX_NUM_BATCHED_TOKENS=8192

# === HuggingFace ===
# Required for gated models (Llama 3.x, etc.). Get one at huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=

# === Codragraph (the package being benchmarked) ===
# Repo to index for the benchmark. Default: codragraph itself (the monorepo).
INDEXED_REPO_PATH=/workspace/repo
# Codragraph version (matches package.json)
CODRAGRAPH_VERSION=0.1.0

# === Closed-API providers (for cross-comparison cells) ===
# Leave empty if you only run open-source models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === Bench script options ===
# Comma-separated workload ids
WORKLOADS=codebase-qa
# Comma-separated treatment tags (see workloads/03-baselines.md)
TREATMENTS=baseline-grep,codragraph-graph-only,codragraph-graph-compress,codragraph-swarm-tuned
# Number of independent runs per cell (recommended: 3 for headline numbers)
RUNS=3
# Output directory under Benchmarking/results/
OUTPUT_DIR=results/$(date +%Y%m%d-%H%M%S)
# Per-task hard timeout (ms)
TASK_TIMEOUT_MS=120000

# === Judge model (for paraphrase scoring on Codebase Q&A) ===
# Cheap small model recommended. Can be a different provider than the benchmarked model.
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-4-5-20251001
